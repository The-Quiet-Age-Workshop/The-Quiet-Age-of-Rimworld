<Defs>

    <RecipeDef Name="TQAR_MetalSmithing" Abstract="True">
        <unfinishedThingDef>EM_UnfinishedAlloy</unfinishedThingDef>
        <effectWorking>Cremate</effectWorking>
        <soundWorking>Recipe_Cremate</soundWorking>
        <workSpeedStat>SmeltingSpeed</workSpeedStat>
        <recipeUsers>
            <li>EM_FueledAlloyFurnace</li>
            <li>EM_ElectricAlloyFurnace</li>
            <li>FueledSmithy</li>
            <li>ElectricSmithy</li>
        </recipeUsers>
        <researchPrerequisite>Smithing</researchPrerequisite> <!-- EM Alloy research project -->
    </RecipeDef>

    <!--Stalbronzes-->

    <RecipeDef ParentName="TQAR_MetalSmithing">
        <defName>MakeCham</defName>
        <label>make cham</label>
        <description>Make stalbronze from copper and tin.</description>
        <jobString>Make stalbronze.</jobString>
        <workAmount>3100</workAmount> <!-- Placeholder -->
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>EM_Copper</li>
                    </thingDefs>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>EM_Tin</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Stalpowder</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>EM_Coal</li>
                        <li>EM_Charcoal</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>EM_Copper</li>
                <li>EM_Tin</li>
                <li>Stalpowder</li>
                <li>EM_Coal</li>
                <li>EM_Charcoal</li>
            </thingDefs>
        </fixedIngredientFilter>
        <products>
            <Cham>1</Cham>
        </products>
        <researchPrerequisite>Smithing</researchPrerequisite>
    </RecipeDef>

