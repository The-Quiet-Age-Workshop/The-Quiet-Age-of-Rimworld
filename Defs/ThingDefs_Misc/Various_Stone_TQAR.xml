<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="UglyRockBase" Name="StalBase_TQAR">
    <defName>Stal_TQAR</defName>
    <label>stal</label>
    <description>A archaic rock composed of stal particles compressed together.</description>
    <graphicData>
      <color>(43,34,56)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
    </statBases>
    <building>
      <mineableThing>ChunkStal_TQAR</mineableThing>
      <mineableDropChance>0.75</mineableDropChance>
      <smoothedThing>SmoothedStal_TQAR</smoothedThing>
    </building>
  </ThingDef>

  <ThingDef ParentName="StalBase_TQAR">
    <defName>SmoothedStal_TQAR</defName>
    <label>smoothed stal</label>
    <description>A archaic rock composed of stal particles compressed together. The stal layers have been polished to a flat, smooth surface.</description>
    <uiIconPath>Things/Building/Linked/WallSmooth_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Linked/RockSmooth_Atlas</texPath>
    </graphicData>
    <statBases>
      <Beauty>1</Beauty>
      <MarketValue>7</MarketValue>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <canBuildNonEdificesUnder>true</canBuildNonEdificesUnder>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <paintable>true</paintable>
      <smoothedThing />
    </building>
    <saveCompressible>false</saveCompressible>
    <repairEffect>Repair</repairEffect>
  </ThingDef>

  <ThingDef ParentName="ChunkRockBase">
    <defName>ChunkStal_TQAR</defName>
    <label>stal chunk</label>
    <graphicData>
      <color>(43,34,56)</color>
    </graphicData>
    <statBases>
      <Mass>10</Mass>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <butcherProducts>
      <BlocksStal_TQAR>20</BlocksStal_TQAR>
    </butcherProducts>
  </ThingDef>

  <ThingDef ParentName="StoneBlocksBase">
    <defName>BlocksStal_TQAR</defName>
    <label>stal blocks</label>
    <description>Blocks of solid stal. Stal is a relatively soft material and chips easily.</description>
    <graphicData>
      <color>(43,34,56)</color>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <SharpDamageMultiplier>0.5</SharpDamageMultiplier>
    </statBases>
    <stuffProps>
      <color>(43,34,56)</color>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <stuffAdjective>stal</stuffAdjective>
      <statFactors>
        <Beauty>1.1</Beauty>  
        <MaxHitPoints>1.4</MaxHitPoints>
        <WorkToBuild>5.0</WorkToBuild>
        <WorkToMake>1.1</WorkToMake>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
  </ThingDef>

  <RecipeDef ParentName="MakeStoneBlocksBase">
    <defName>Make_StoneBlocksStal_TQAR</defName>
    <label>make stal blocks</label>
    <description>Cuts stal chunks into usable blocks.</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ChunkStal_TQAR</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ChunkStal_TQAR</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <BlocksStal_TQAR>20</BlocksStal_TQAR>
    </products>
  </RecipeDef>

  <RecipeDef ParentName="MakeStoneBlocksBase">
    <defName>Make_StalPowder</defName>
    <label>make stal powder</label>
    <description>Cuts stal chunks into usable powder.</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ChunkStal_TQAR</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ChunkStal_TQAR</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Stalpowder>20</Stalpowder>
    </products>
  </RecipeDef>

</Defs>